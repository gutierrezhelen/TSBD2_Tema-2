---
import { getCourses, createCourse, updateCourse, deleteCourse } from '../services/courseService.js';
const { setView } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <title>Cursos</title>
  <link rel="stylesheet" href="/styles/estilos.css" />
</head>

<div class="container">
  <h1>📚 Cursos</h1>

  <div class="acciones">
    <input type="text" id="searchInput" placeholder="Buscar curso..." />
    <button id="addBtn">➕ Agregar Curso</button>
    <button id="homeBtn">🏠 Volver al inicio</button>
  </div>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Profesor</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody id="courseTableBody"></tbody>
  </table>

  <!-- Modal -->
  <div id="modal" class="modal" style="display:none;">
    <div class="modal-content">
      <span id="closeModal">&times;</span>
      <h2 id="modalTitle"></h2>
      <input id="nameInput" placeholder="Nombre" />
      <input id="teacherInput" placeholder="Profesor" />
      <button id="saveBtn">💾 Guardar</button>
    </div>
  </div>

  <script type="module">
    let courses = [];
    let editing = null;

    const tableBody = document.getElementById("courseTableBody");
    const modal = document.getElementById("modal");
    const nameInput = document.getElementById("nameInput");
    const teacherInput = document.getElementById("teacherInput");
    const modalTitle = document.getElementById("modalTitle");

    async function loadCourses() {
      courses = await getCourses();
      render();
    }

    function render() {
      tableBody.innerHTML = "";
      courses.forEach(c => {
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${c.id}</td>
          <td>${c.name}</td>
          <td>${c.teacher}</td>
          <td>
            <button data-id="${c.id}" class="editBtn">✏ Editar</button>
            <button data-id="${c.id}" class="deleteBtn">🗑 Eliminar</button>
          </td>`;
        tableBody.appendChild(tr);
      });
    }

    document.getElementById("addBtn").onclick = () => {
      editing = null;
      modalTitle.textContent = "Agregar Curso";
      nameInput.value = "";
      teacherInput.value = "";
      modal.style.display = "flex";
    };

    document.getElementById("closeModal").onclick = () => modal.style.display = "none";

    document.getElementById("saveBtn").onclick = async () => {
      const data = { name: nameInput.value, teacher: teacherInput.value };
      if (editing) await updateCourse(editing, data);
      else await createCourse(data);
      modal.style.display = "none";
      await loadCourses();
    };

    tableBody.addEventListener("click", async e => {
      if (e.target.classList.contains("editBtn")) {
        const id = e.target.dataset.id;
        const course = courses.find(c => c.id == id);
        editing = id;
        modalTitle.textContent = "Editar Curso";
        nameInput.value = course.name;
        teacherInput.value = course.teacher;
        modal.style.display = "flex";
      }
      if (e.target.classList.contains("deleteBtn")) {
        await deleteCourse(e.target.dataset.id);
        await loadCourses();
      }
    });

    document.getElementById("homeBtn").onclick = () => {
      window.dispatchEvent(new CustomEvent("setView", { detail: "home" }));
    };

    loadCourses();
  </script>
</div>
